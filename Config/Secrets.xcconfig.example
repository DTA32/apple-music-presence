// Copy to Config/Secrets.xcconfig (gitignored) and fill in. See README → "One-time setup".

// discord.com/developers → your "Apple Music" application → General Information → Application ID
DISCORD_CLIENT_ID =

// last.fm/api/account/create → API key and Shared secret
LASTFM_API_KEY =
LASTFM_SHARED_SECRET =

// Stable code signing with your free Personal Team (Xcode → Settings → Accounts → add Apple ID →
// Manage Certificates → + → Apple Development). Manual style: this app needs no provisioning profile.
// Team ID = the certificate's OU field, NOT the code in parentheses in its name:
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
// CODE_SIGN_STYLE = Manual
// CODE_SIGN_IDENTITY = Apple Development
// DEVELOPMENT_TEAM = ABCDE12345
